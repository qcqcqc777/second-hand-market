<?xml version="1.0" encoding="UTF-8" ?>
        <!DOCTYPE mapper
                PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
                "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tekram.mapper.CategoryMapper">
<!--    分类列表查询-->
    <select id="getCategory" resultType="com.tekram.pojo.Category">
        select c.id,c.category_name from category c order by sort_order
    </select>
</mapper>
